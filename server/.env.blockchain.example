# Blockchain Configuration (Simulated Environment)

# RPC URL for local Hardhat network (run: npm run node)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Private key of Hardhat account #0 (has 10000 ETH pre-funded)
# This is the default Hardhat test account - ONLY for development!
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Contract address (set after deploying with: npm run deploy:localhost)
BLOCKCHAIN_CONTRACT_ADDRESS=

# Optional: Set to 'false' to disable blockchain features
BLOCKCHAIN_ENABLED=true

# Network chain ID (31337 = Hardhat local network)
BLOCKCHAIN_CHAIN_ID=31337
